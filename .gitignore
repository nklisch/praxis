# Node
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo
# Electron packager output (packages/desktop)
packages/desktop/out/
# Electron-builder output (packages/desktop/release/*.dmg, *.exe, etc.)
packages/desktop/release/
# Staging dir produced by build-dist.sh (pnpm deploy + electron-builder)
packages/desktop/.deploy/

# Env / secrets
.env
.env.*
!.env.example

# Local db / cache
.praxis/
*.db
*.db-journal
*.db-wal
*.db-shm

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Tests / coverage
coverage/
test-results/
playwright-report/
# Compiled output that may leak into tests/helpers if a tsc -b picks them up
tests/helpers/*.js
tests/helpers/*.d.ts
tests/helpers/*.js.map
tests/helpers/*.d.ts.map

# Drizzle: keep migrations/, ignore meta-cache
drizzle/meta/_journal.bak

# Claude Code: per-machine session artefacts
.claude/scheduled_tasks.lock
.claude/settings.local.json
