# Node
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo
# Electron packager output (packages/desktop)
packages/desktop/out/

# Env / secrets
.env
.env.*
!.env.example

# Local db / cache
.praxis/
*.db
*.db-journal
*.db-wal
*.db-shm

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Tests / coverage
coverage/
# Compiled output that may leak into tests/helpers if a tsc -b picks them up
tests/helpers/*.js
tests/helpers/*.d.ts
tests/helpers/*.js.map
tests/helpers/*.d.ts.map

# Drizzle: keep migrations/, ignore meta-cache
drizzle/meta/_journal.bak

# Skilltap-managed skill installations — only the project's own
# .claude/skills/patterns/ and SKILL.md are tracked.
.agents/
.claude/skills/*
!.claude/skills/patterns/
!.claude/skills/SKILL.md
