{
  "name": "@praxis/desktop",
  "version": "0.1.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "rebuild:electron": "electron-rebuild --force --only canvas,better-sqlite3",
    "_resign:mac": "find release -name 'Praxis.app' -maxdepth 3 -exec codesign --force --deep --sign - {} \\;",
    "dist": "pnpm rebuild:electron && electron-vite build && electron-builder && pnpm _resign:mac",
    "dist:mac": "pnpm rebuild:electron && electron-vite build && electron-builder --mac && pnpm _resign:mac",
    "dist:win": "pnpm rebuild:electron && electron-vite build && electron-builder --win",
    "dist:linux": "pnpm rebuild:electron && electron-vite build && electron-builder --linux",
    "dist:dir": "pnpm rebuild:electron && electron-vite build && electron-builder --dir && pnpm _resign:mac"
  },
  "dependencies": {
    "@praxis/artifacts": "workspace:*",
    "@praxis/client": "workspace:*",
    "@praxis/core": "workspace:*",
    "@praxis/curriculum": "workspace:*",
    "@praxis/engines": "workspace:*",
    "@praxis/memory": "workspace:*",
    "@praxis/tools": "workspace:*",
    "@praxis/ui": "workspace:*",
    "better-sqlite3": "^12.9.0",
    "sqlite-vec": "^0.1.9"
  },
  "optionalDependencies": {
    "sqlite-vec-darwin-arm64": "0.1.9",
    "sqlite-vec-darwin-x64": "0.1.9",
    "sqlite-vec-linux-arm64": "0.1.9",
    "sqlite-vec-linux-x64": "0.1.9",
    "sqlite-vec-windows-x64": "0.1.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "41.4.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.praxis.tutor",
    "productName": "Praxis",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/isolated-vm/**",
      "!**/node_modules/@praxis/*/src/**",
      "!**/node_modules/@praxis/*/dist/.tsbuildinfo",
      "!**/node_modules/@praxis/*/dist/**/*.d.ts",
      "!**/node_modules/@praxis/*/dist/**/*.d.ts.map",
      "!**/node_modules/@praxis/*/dist/**/*.js.map",
      "!**/node_modules/@praxis/*/__tests__/**",
      "!**/.agents/**",
      "!**/.claude/**",
      "!**/docs/**",
      "!**/*.md"
    ],
    "extraResources": [
      {
        "from": "../../drizzle",
        "to": "drizzle",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/canvas/**",
      "**/node_modules/sqlite-vec/**",
      "**/node_modules/sqlite-vec-*/**",
      "**/node_modules/@img/sharp-*/**",
      "**/node_modules/sharp/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "identity": null,
      "type": "development"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    }
  }
}
