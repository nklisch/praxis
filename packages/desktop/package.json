{
  "name": "@praxis/desktop",
  "version": "0.1.0",
  "type": "module",
  "main": "out/main/index.js",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "rebuild:electron": "electron-rebuild --force --only canvas,better-sqlite3",
    "dist": "pnpm rebuild:electron && electron-vite build && electron-builder",
    "dist:mac": "pnpm rebuild:electron && electron-vite build && electron-builder --mac",
    "dist:win": "pnpm rebuild:electron && electron-vite build && electron-builder --win",
    "dist:linux": "pnpm rebuild:electron && electron-vite build && electron-builder --linux",
    "dist:dir": "pnpm rebuild:electron && electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@praxis/client": "workspace:*",
    "@praxis/core": "workspace:*",
    "@praxis/curriculum": "workspace:*",
    "@praxis/tools": "workspace:*",
    "@praxis/ui": "workspace:*"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "41.4.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.praxis.tutor",
    "productName": "Praxis",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../drizzle",
        "to": "drizzle",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/canvas/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    }
  }
}
