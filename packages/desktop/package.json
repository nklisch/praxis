{
  "name": "@praxis/desktop",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "rebuild:electron": "electron-rebuild --force --only canvas,better-sqlite3",
    "dist": "bash scripts/build-dist.sh",
    "dist:mac": "bash scripts/build-dist.sh mac",
    "dist:win": "bash scripts/build-dist.sh win",
    "dist:linux": "bash scripts/build-dist.sh linux",
    "dist:dir": "bash scripts/build-dist.sh dir"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.73",
    "@ai-sdk/gateway": "^3.0.107",
    "@ai-sdk/google": "^3.0.66",
    "@ai-sdk/openai": "^3.0.55",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@openai/codex-sdk": "^0.128.0",
    "@opentelemetry/api": "^1.9.0",
    "@praxis/artifacts": "workspace:*",
    "@praxis/claude-cli-sdk": "workspace:*",
    "@praxis/client": "workspace:*",
    "@praxis/core": "workspace:*",
    "@praxis/curriculum": "workspace:*",
    "@praxis/engines": "workspace:*",
    "@praxis/memory": "workspace:*",
    "@praxis/tools": "workspace:*",
    "@praxis/ui": "workspace:*",
    "ai": "^6.0.172",
    "better-sqlite3": "^12.9.0",
    "bindings": "^1.5.0",
    "canvas": "^3.2.3",
    "drizzle-orm": "^0.45.2",
    "epub2": "^3.0.2",
    "file-uri-to-path": "^1.0.0",
    "linkedom": "^0.18.12",
    "mammoth": "^1.12.0",
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4",
    "ollama-ai-provider-v2": "^3.5.0",
    "pdfjs-dist": "^5.7.284",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "pino-roll": "^3.0.0",
    "pyodide": "^0.29.3",
    "sqlite-vec": "^0.1.9",
    "tldraw": "^4.0.0",
    "ts-fsrs": "^5.3.2",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "sqlite-vec-darwin-arm64": "0.1.9",
    "sqlite-vec-darwin-x64": "0.1.9",
    "sqlite-vec-linux-arm64": "0.1.9",
    "sqlite-vec-linux-x64": "0.1.9",
    "sqlite-vec-windows-x64": "0.1.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "41.4.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.praxis.tutor",
    "productName": "Praxis",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/@praxis/*/src/**",
      "!**/node_modules/@praxis/*/dist/.tsbuildinfo",
      "!**/node_modules/@praxis/*/dist/**/*.d.ts",
      "!**/node_modules/@praxis/*/dist/**/*.d.ts.map",
      "!**/node_modules/@praxis/*/dist/**/*.js.map",
      "!**/node_modules/@praxis/*/__tests__/**",
      "!**/.agents/**",
      "!**/.claude/**",
      "!**/docs/**",
      "!**/*.md"
    ],
    "extraResources": [
      {
        "from": "../../drizzle",
        "to": "drizzle",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/canvas/**",
      "**/node_modules/sqlite-vec/**",
      "**/node_modules/sqlite-vec-*/**",
      "**/node_modules/@img/sharp-*/**",
      "**/node_modules/sharp/**",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/onnxruntime-common/**"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.education",
      "type": "distribution",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": null,
      "notarize": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    }
  }
}
